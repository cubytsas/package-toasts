{
  "name": "@cubyt/toasts",
  "version": "1.0.1",
  "description": "Accessible toast notifications (store, vanilla renderer, React Toaster) for Cubyt apps",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cubytsas/package-toasts.git"
  },
  "homepage": "https://github.com/cubytsas/package-toasts#readme",
  "bugs": {
    "url": "https://github.com/cubytsas/package-toasts/issues"
  },
  "type": "module",
  "main": "./src/index.js",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./src/index.js",
      "default": "./src/index.js"
    },
    "./react": {
      "types": "./types/react.d.ts",
      "import": "./src/react.js",
      "default": "./src/react.js"
    },
    "./toasts.css": "./toasts.css",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "types",
    "toasts.css",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": [
    "./toasts.css"
  ],
  "scripts": {
    "test": "node --test",
    "prepublishOnly": "npm test"
  },
  "dependencies": {
    "@cubyt/navigation": "^1.0.0",
    "@cubyt/ui": "^1.0.0"
  },
  "peerDependencies": {
    "@cubyt/style": "^1.0.1",
    "react": ">=19",
    "react-dom": ">=19"
  },
  "peerDependenciesMeta": {
    "@cubyt/style": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
